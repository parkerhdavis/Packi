# ────────────────────────────────────────────────────────────────────────────────
# Environment & Secrets (NEVER commit)
# ────────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ────────────────────────────────────────────────────────────────────────────────
# Dependencies
# ────────────────────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
# bun.lock IS tracked at the repo root (required for reproducible workspace
# installs); per-subfolder lockfiles should not appear.
**/bun.lockb

# ────────────────────────────────────────────────────────────────────────────────
# Build Artifacts & Distribution
# ────────────────────────────────────────────────────────────────────────────────
# Rust / Cargo. `target/` lives at the repo root — `.cargo/config.toml`
# redirects cargo's output there so it doesn't clutter the backend dir.
target/
**/*.rs.bk
*.pdb
**/WixTools/
# Tauri-generated capability files
**/gen/

# Frontend bundler output
dist/
dist-ssr/
**/dist/
**/dist-ssr/

# TypeScript incremental build info
*.tsbuildinfo
**/*.tsbuildinfo

# ────────────────────────────────────────────────────────────────────────────────
# Logs & Temporary Files
# ────────────────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
*.tmp
*.temp
.vite.pid
.dev.pid

# ────────────────────────────────────────────────────────────────────────────────
